# ==============================================================================
# TrustShare - Docker Environment Configuration
# ==============================================================================

# Platform Security Keys
PROJECT_NAME=TrustShare
API_V1_STR=/api/v1
SECRET_KEY=trustshare_dev_super_secret_key_2026_change_in_prod

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=trustshare_secure_db_pass
POSTGRES_DB=TrustShare_Users
POSTGRES_PORT=5432

# Redis Cache
REDIS_URL=redis://redis:6379/0

# MongoDB Atlas (Audit Logging & Security Alerts)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.jegyxqy.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=TrustShare_Logs

# AWS S3 Cloud Storage Vault (Milestone 2)
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=your_s3_bucket_name

# File Storage Vault
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

