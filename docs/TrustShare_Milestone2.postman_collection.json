{
  "info": {
    "name": "TrustShare - Milestone 2 tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order. 1) log in as a normal user, upload, share. 2) log in as a second user to test denial. 3) admin-only checks."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refresh",
      "value": ""
    },
    {
      "key": "fileId",
      "value": ""
    },
    {
      "key": "linkId",
      "value": ""
    },
    {
      "key": "shareToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"full_name\": \"Alice Test\",\n  \"password\": \"Passw0rdTest\"\n}"
            }
          }
        },
        {
          "name": "Login (JSON)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"Passw0rdTest\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.access_token);",
                  "pm.collectionVariables.set('refresh', j.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (OAuth2 password flow)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/token",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "username",
                  "value": "alice@example.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "Passw0rdTest",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.access_token);",
                  "pm.collectionVariables.set('refresh', j.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Encrypt + store",
      "item": [
        {
          "name": "Upload file (choose a PDF in Body)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/files/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('fileId', pm.response.json().id);",
                  "pm.test('upload ok', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload EICAR test file -> must be blocked (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/files/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('threat blocked', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Download (decrypted)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/files/{{fileId}}/download"
          }
        },
        {
          "name": "List files",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/files"
          }
        }
      ]
    },
    {
      "name": "3. Share links",
      "item": [
        {
          "name": "Create 24h link (view-only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/share/links/{{fileId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ttl_hours\": 24,\n  \"allow_download\": false,\n  \"max_downloads\": 3\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('linkId', j.id);",
                  "pm.collectionVariables.set('shareToken', j.url.split('/share/')[1]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Public info (no login)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/share/public/{{shareToken}}"
          }
        },
        {
          "name": "Public download -> 403 on view-only link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/share/public/{{shareToken}}/access",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"download\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('download denied', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Public view",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/share/public/{{shareToken}}/access",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"view\"\n}"
            }
          }
        },
        {
          "name": "Revoke link",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/share/links/{{linkId}}"
          }
        },
        {
          "name": "Use revoked link -> 410",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/share/public/{{shareToken}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('revoked = gone', () => pm.response.to.have.status(410));"
                ]
              }
            }
          ]
        },
        {
          "name": "Shared by me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/share/by-me"
          }
        }
      ]
    },
    {
      "name": "4. Access control (log in as a DIFFERENT user first)",
      "item": [
        {
          "name": "Download someone else's file -> 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/files/{{fileId}}/download"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('denied', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin security dashboard as normal user -> 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/reports/security-dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('RBAC blocks', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Trash + favorites",
      "item": [
        {
          "name": "Star a file",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/files/{{fileId}}/favorite"
          }
        },
        {
          "name": "Move to Trash",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/files/{{fileId}}"
          }
        },
        {
          "name": "Download trashed file -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/files/{{fileId}}/download"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('hidden', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Trash list",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/files?scope=trash"
          }
        },
        {
          "name": "Restore",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/files/{{fileId}}/restore"
          }
        }
      ]
    },
    {
      "name": "6. Admin (log in as admin@trustshare.com)",
      "item": [
        {
          "name": "Security dashboard data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/reports/security-dashboard?days=14"
          }
        },
        {
          "name": "Key status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/admin/keys/status"
          }
        },
        {
          "name": "Rotate keys",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/admin/keys/rotate"
          }
        }
      ]
    }
  ]
}