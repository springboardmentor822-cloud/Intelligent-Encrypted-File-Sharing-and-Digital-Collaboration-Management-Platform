{
  "info": {
    "name": "TrustShare API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the folders top to bottom. Tests save tokens and ids into collection variables."
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "email",
      "value": "usha@trustshare.local"
    },
    {
      "key": "password",
      "value": "Demo@12345"
    },
    {
      "key": "admin_email",
      "value": "admin@trustshare.local"
    },
    {
      "key": "admin_password",
      "value": "CHANGE_ME"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/register",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.user@example.com\",\n  \"password\": \"Passw0rd-1\",\n  \"full_name\": \"New User\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('has access token', () => pm.expect(j.access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('access_token', j.access_token);",
                  "pm.collectionVariables.set('refresh_token', j.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/me",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/refresh",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('access_token', j.access_token);",
                  "pm.collectionVariables.set('refresh_token', j.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/sessions",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "sessions"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/logout",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Files (encrypted)",
      "item": [
        {
          "name": "Upload file",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/files/upload",
              "host": [
                "{{base}}"
              ],
              "path": [
                "files",
                "upload"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('file_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List files",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/files",
              "host": [
                "{{base}}"
              ],
              "path": [
                "files"
              ]
            }
          }
        },
        {
          "name": "Download (decrypts)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/files/{{file_id}}/download",
              "host": [
                "{{base}}"
              ],
              "path": [
                "files",
                "{{file_id}}",
                "download"
              ]
            }
          }
        },
        {
          "name": "Inline view",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/files/{{file_id}}/view",
              "host": [
                "{{base}}"
              ],
              "path": [
                "files",
                "{{file_id}}",
                "view"
              ]
            }
          }
        },
        {
          "name": "Versions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/files/{{file_id}}/versions",
              "host": [
                "{{base}}"
              ],
              "path": [
                "files",
                "{{file_id}}",
                "versions"
              ]
            }
          }
        },
        {
          "name": "Storage usage",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/files/storage/usage",
              "host": [
                "{{base}}"
              ],
              "path": [
                "files",
                "storage",
                "usage"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Sharing",
      "item": [
        {
          "name": "Create share link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/shares/links",
              "host": [
                "{{base}}"
              ],
              "path": [
                "shares",
                "links"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_id\": \"{{file_id}}\",\n  \"permission\": \"download\",\n  \"expires_in_hours\": 24,\n  \"max_downloads\": 3\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('share_token', j.token);",
                  "pm.collectionVariables.set('link_id', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Public: link info (no auth)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/public/share/{{share_token}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "public",
                "share",
                "{{share_token}}"
              ]
            }
          }
        },
        {
          "name": "Public: download (no auth)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/public/share/{{share_token}}/download",
              "host": [
                "{{base}}"
              ],
              "path": [
                "public",
                "share",
                "{{share_token}}",
                "download"
              ]
            }
          }
        },
        {
          "name": "Revoke link",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/shares/links/{{link_id}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "shares",
                "links",
                "{{link_id}}"
              ]
            }
          }
        },
        {
          "name": "Public after revoke -> 410",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/public/share/{{share_token}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "public",
                "share",
                "{{share_token}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('revoked -> 410', () => pm.response.to.have.status(410));"
                ]
              }
            }
          ]
        },
        {
          "name": "Share with a user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/shares/users",
              "host": [
                "{{base}}"
              ],
              "path": [
                "shares",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_id\": \"{{file_id}}\",\n  \"email\": \"rohit@trustshare.local\",\n  \"permission\": \"view\"\n}"
            }
          }
        },
        {
          "name": "Shared with me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/shares/with-me",
              "host": [
                "{{base}}"
              ],
              "path": [
                "shares",
                "with-me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Access control (expect 401/403)",
      "item": [
        {
          "name": "No token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/files",
              "host": [
                "{{base}}"
              ],
              "path": [
                "files"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "User hits admin API -> 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/admin/users",
              "host": [
                "{{base}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Admin",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Security summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/admin/security/summary",
              "host": [
                "{{base}}"
              ],
              "path": [
                "admin",
                "security",
                "summary"
              ]
            }
          }
        },
        {
          "name": "Security events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/admin/security/events",
              "host": [
                "{{base}}"
              ],
              "path": [
                "admin",
                "security",
                "events"
              ]
            }
          }
        },
        {
          "name": "Audit logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/admin/audit-logs",
              "host": [
                "{{base}}"
              ],
              "path": [
                "admin",
                "audit-logs"
              ]
            }
          }
        },
        {
          "name": "Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/admin/users",
              "host": [
                "{{base}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            }
          }
        },
        {
          "name": "Key status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/admin/keys",
              "host": [
                "{{base}}"
              ],
              "path": [
                "admin",
                "keys"
              ]
            }
          }
        },
        {
          "name": "Rotate keys",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/admin/keys/rotate",
              "host": [
                "{{base}}"
              ],
              "path": [
                "admin",
                "keys",
                "rotate"
              ]
            }
          }
        },
        {
          "name": "System",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/admin/system",
              "host": [
                "{{base}}"
              ],
              "path": [
                "admin",
                "system"
              ]
            }
          }
        }
      ]
    }
  ]
}