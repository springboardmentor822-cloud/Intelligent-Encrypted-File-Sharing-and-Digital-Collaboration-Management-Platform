# ===== Copy this file to .env and fill in real values. =====
# Generate a master key:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Generate JWT secret:    python -c "import secrets;print(secrets.token_urlsafe(48))"
ENVIRONMENT=development

# PostgreSQL
POSTGRES_USER=trustshare
POSTGRES_PASSWORD=change_me
POSTGRES_DB=trustshare_db

# MongoDB
MONGO_INITDB_ROOT_USERNAME=trustshare
MONGO_INITDB_ROOT_PASSWORD=change_me

# Redis
REDIS_PASSWORD=change_me

# JWT signing secret
JWT_SECRET=change_me_long_random_string

# AES-256 master keys (KEK). Format: version:base64(32 random bytes)
# To rotate: add ",v2:<new key>" here and set MASTER_KEY_CURRENT=v2, restart, then call POST /admin/keys/rotate
MASTER_KEYS=v1:GENERATE_32_RANDOM_BYTES_BASE64
MASTER_KEY_CURRENT=v1

# Storage: "local" for development, "s3" for AWS
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Limits
MAX_UPLOAD_MB=25

# URLs
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# The account that registers with this email automatically becomes ADMIN
ADMIN_EMAIL=admin@trustshare.com

# Email (optional). Leave SMTP_HOST empty and emails are printed in the backend logs instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@trustshare.local

# ----- Added in version 2 (all optional) -----
# Files stay in the Trash this many days, then are deleted forever
TRASH_RETENTION_DAYS=30
# Look up the city/country of login IPs for the Security Dashboard (sends the IP to ipwho.is). Off by default.
GEOIP_ENABLED=false
# One IP failing logins on this many different accounts within 10 minutes raises a "suspicious IP" alert
ALERT_SUSPICIOUS_IP_ACCOUNTS=3
# "Continue with Google" (OAuth2). Leave empty to hide the button. See docs/OAUTH2_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000

# ----- Version 3.1 -----
# Storage limit in MB. It applies to the whole platform AND to each user. 1024 MB = 1 GB.
STORAGE_LIMIT_MB=1024
# Warning alerts to the admins when the platform is this full (percent)
STORAGE_WARN_PERCENT=80
STORAGE_CRITICAL_PERCENT=95
# ADMIN ACCOUNT. At every start the account with the ADMIN_EMAIL set above is given the admin role.
# If it does not exist yet AND ADMIN_PASSWORD is set (8+ characters, a letter and a number), it is created for you.
# (Leave ADMIN_EMAIL as the e-mail you register with. After changing it, restart: docker compose up -d --build)
ADMIN_PASSWORD=
# Safety net for a student project: if NO administrator exists at start-up, the OLDEST account is made admin.
# Set to false in a real deployment.
PROMOTE_FIRST_USER=true
