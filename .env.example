# Copy to .env, or run:  python scripts/generate_env.py   (fills every secret with random values)

ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Databases ---
POSTGRES_USER=trustshare
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=trustshare
MONGO_DB=trustshare

# --- Auth ---
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Encryption keys (AES-256 master keys, versioned: "version:base64,version:base64") ---
KEY_PROVIDER=local
MASTER_KEYS=1:CHANGE_ME
ACTIVE_KEY_VERSION=1
# KEY_PROVIDER=aws_kms  ->  KMS_KEY_ID=arn:aws:kms:...   KMS_REGION=ap-south-1

# --- Object storage. Dev uses the MinIO container; for AWS S3 leave S3_ENDPOINT_URL empty ---
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=trustshare-files
S3_REGION=us-east-1
S3_ACCESS_KEY=trustshare-minio
S3_SECRET_KEY=CHANGE_ME
S3_SSE=false

# --- Limits ---
MAX_UPLOAD_MB=100
DEFAULT_QUOTA_GB=100

# --- Bootstrap ---
ADMIN_EMAIL=admin@trustshare.local
ADMIN_PASSWORD=CHANGE_ME
SEED_DEMO_USERS=true

# --- Email (dev: MailHog catches everything at http://localhost:8025) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=TrustShare <no-reply@trustshare.local>

# --- OAuth2 (optional). Redirect URI: <BACKEND_PUBLIC_URL>/api/v1/auth/oauth/<google|microsoft>/callback ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
