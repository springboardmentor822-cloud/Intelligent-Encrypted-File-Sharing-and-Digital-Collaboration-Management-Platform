# Copy to .env and fill in. NEVER commit .env.
TS_ENV=development                      # development | production
TS_DATABASE_URL=sqlite:///./data/trustshare.db
# Postgres: postgresql+psycopg://trustshare:CHANGE_ME@localhost:5432/trustshare
TS_JWT_SECRET=                          # production: python -c "import secrets;print(secrets.token_urlsafe(64))"
# Master keys (KEKs): "version:base64(32 bytes)", comma separated. Production REQUIRED.
# Generate: python -c "import os,base64;print('1:'+base64.b64encode(os.urandom(32)).decode())"
TS_MASTER_KEYS=
TS_ACTIVE_KEY_VERSION=1
TS_CORS_ORIGINS=http://localhost:5173
TS_FRONTEND_URL=http://localhost:5173
TS_PUBLIC_BASE_URL=http://localhost:8000
TS_HTTPS_ENFORCED=false                 # true only behind a TLS-terminating proxy
TS_TRUST_PROXY=false                    # true only if a trusted proxy sets X-Forwarded-For
TS_MAX_UPLOAD_MB=25
TS_USER_QUOTA_MB=1024
TS_STORAGE_BACKEND=local                # local | s3
TS_LOCAL_STORAGE_DIR=./data/objects
TS_S3_BUCKET=
TS_S3_REGION=
TS_S3_ENDPOINT_URL=
TS_S3_PREFIX=trustshare/
# AWS credentials come from the standard AWS environment/role chain (AWS_ACCESS_KEY_ID, ... or an IAM role)
TS_GOOGLE_CLIENT_ID=
TS_GOOGLE_CLIENT_SECRET=
TS_MICROSOFT_CLIENT_ID=
TS_MICROSOFT_CLIENT_SECRET=
TS_MICROSOFT_TENANT=common
# --- Admin Visit: password-gated entry to the admin panel from ANY signed-in account ---
TS_ADMIN_VISIT_PASSWORD=123meadmin      # CHANGE THIS in production
TS_ADMIN_VISIT_MINUTES=60               # lifetime of one elevated visit
TS_ADMIN_VISIT_MAX_ATTEMPTS=5           # failures per minute per IP before rate limiting
TS_DEV_EXPOSE_TOKENS=false              # dev only: show password-reset tokens (no email provider is wired in)
