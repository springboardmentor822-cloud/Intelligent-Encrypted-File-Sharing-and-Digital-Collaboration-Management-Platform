MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=trustshare
MYSQL_USER=trustshare_user
MYSQL_PASSWORD=change_me_for_local_development

MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=trustshare
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Secure cookies are the safe default. Set false only for local HTTP development.
SESSION_COOKIE_SECURE=true

# Suspicious activity thresholds (window sizes are fixed by the detector).
FAILED_LOGIN_THRESHOLD=5
DOWNLOAD_THRESHOLD=20
UNAUTHORIZED_THRESHOLD=3
EXPIRED_LINK_THRESHOLD=3
REVOKED_LINK_THRESHOLD=3
# Comma-separated numeric user IDs that receive security alert notifications.
SECURITY_ALERT_ADMIN_IDS=
SHARE_EXPIRY_REMINDER_INTERVAL_SECONDS=60
# Optional comma-separated SMTP recipients for data-minimized security alert emails.
SECURITY_ALERT_EMAILS=

FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8000/auth/google/gmail/callback
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=replace_with_a_generated_fernet_key
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback
MICROSOFT_TENANT=consumers
MICROSOFT_LINK_REDIRECT_URI=http://localhost:8000/auth/microsoft/link/callback

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Use the SMTP account credentials supplied by your mail provider.
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

MAX_UPLOAD_SIZE_BYTES=26214400
# Per-user quota defaults to 4 GiB when not set.
USER_STORAGE_QUOTA_BYTES=4294967296
ALLOWED_FILE_EXTENSIONS=.pdf,.doc,.docx,.txt,.ppt,.pptx,.xls,.xlsx,.csv,.png,.jpg,.jpeg,.gif,.webp,.svg,.zip

# Envelope-encryption key-encryption key (Fernet format; back up outside the database).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_KEY_ENCRYPTION_KEY=replace-with-generated-fernet-key
# Legacy version-0 objects are blocked by default. Enable only during a controlled migration.
ALLOW_LEGACY_PLAINTEXT_DOWNLOADS=false

# Encrypted local storage is the default. To use a private S3 bucket, set backend=s3,
# supply S3_BUCKET and AWS_REGION, and grant the process role put/get/head/delete access.
# AWS credentials should come from the AWS SDK credential chain (instance/task role preferred).
FILE_STORAGE_BACKEND=local
S3_BUCKET=
AWS_REGION=
